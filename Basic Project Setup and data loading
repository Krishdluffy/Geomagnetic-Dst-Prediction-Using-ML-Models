import pandas as pd

def load_dataset(path="data/omni.csv"):
    df = pd.read_csv(path)

    features = [
        "YEAR", "DOY", "Hour",
        "Scalar_B_nT", "BZ_nT",
        "SW_Proton_Density",
        "Kp_index", "ap_index"
    ]

    target = "Dst_index"

    X = df[features]
    y = df[target]

    return X, y, df
