from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.ensemble import ExtraTreesRegressor, GradientBoostingRegressor
from xgboost import XGBRegressor
from load_data import load_dataset
from sklearn.metrics import mean_squared_error, r2_score

X, y, df = load_dataset()

# Train-test split
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.2, shuffle=True, random_state=42
)

# Linear Regression
lr = LinearRegression()
lr.fit(X_train, y_train)
pred_lr = lr.predict(X_test)

# Extra Trees
extra = ExtraTreesRegressor(n_estimators=300, random_state=42)
extra.fit(X_train, y_train)
pred_extra = extra.predict(X_test)

# Gradient Boosting
gbr = GradientBoostingRegressor()
gbr.fit(X_train, y_train)
pred_gbr = gbr.predict(X_test)

# XGBoost
xgb = XGBRegressor(n_estimators=300, learning_rate=0.05, max_depth=6)
xgb.fit(X_train, y_train)
pred_xgb = xgb.predict(X_test)

# Print results
print("LinearRegression:", mean_squared_error(y_test, pred_lr, squared=False),
      "R2 =", r2_score(y_test, pred_lr))

print("ExtraTrees:", mean_squared_error(y_test, pred_extra, squared=False),
      "R2 =", r2_score(y_test, pred_extra))

print("GradientBoosting:", mean_squared_error(y_test, pred_gbr, squared=False),
      "R2 =", r2_score(y_test, pred_gbr))

print("XGBoost:", mean_squared_error(y_test, pred_xgb, squared=False),
      "R2 =", r2_score(y_test, pred_xgb))
